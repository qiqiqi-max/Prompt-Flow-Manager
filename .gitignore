# 依赖
node_modules/

# 构建产物
dist/

# 运行时数据（由应用自动生成）
.versions/
.trash/
config.json
projects.json
workflow-runs.json
projects.json.corrupt-*
workflow-runs.json.corrupt-*
# 使用统计与收藏（本机数据，和 config.json 放在同一目录）
usage.json
*.log
# 开发模式下 DATA_ROOT 就是仓库根目录，所以滚动日志会落在这里。
# *.log 已经覆盖 app.log / app-1.log，但显式写上目录名，免得以后有人
# 往 logs/ 里加个别的后缀就悄悄进了提交。
logs/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
*.tmp
.tmp-*

# 关窗那次同步写的临时文件（正常路径下会被 rename 掉，被 kill 时会留下）
*.tmp-close

# 自检用的 Chromium 配置目录（PFM_DATA_DIR 指向仓库时会产生）
__chromium-profile/
