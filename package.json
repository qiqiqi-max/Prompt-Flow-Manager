{
  "name": "prompt-flow-manager",
  "version": "1.3.0",
  "description": "提示词流程管理系统 - 本地桌面应用",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/smoke.test.js",
    "test:ui": "node tests/ui-smoke.js",
    "test:fn": "node tests/functional-smoke.js",
    "test:all": "npm test && npm run test:ui && npm run test:fn",
    "bench": "node tests/search-bench.js",
    "sync-vendor": "node scripts/sync-vendor.js",
    "prebuild": "node scripts/sync-vendor.js",
    "build": "electron-builder --win",
    "predist": "node scripts/sync-vendor.js",
    "dist": "electron-builder --win portable"
  },
  "keywords": [
    "prompt",
    "workflow",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.0.6",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "marked": "^11.1.1"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "yauzl": "2.10.0"
  },
  "build": {
    "appId": "com.promptflow.manager",
    "productName": "Prompt Flow Manager",
    "files": [
      "electron-main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "prompts/**/*",
      "workflows/**/*",
      "templates/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "icon": "build/icon.png"
    }
  }
}
