{
  "name": "prompt-flow-manager",
  "version": "1.6.0",
  "description": "提示词流程管理系统 - 本地桌面应用",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/smoke.test.js",
    "test:ui": "node tests/ui-smoke.js",
    "test:fn": "node tests/functional-smoke.js",
    "test:tabs": "node tests/tab-restore.test.js",
    "test:debounce": "node tests/debounce.test.js",
    "test:close": "node tests/close-flush.test.js",
    "test:render": "node tests/render-guard.test.js",
    "test:heal": "node tests/heal.test.js",
    "test:logger": "node tests/logger.test.js",
    "test:sandbox": "node tests/sandbox.test.js",
    "test:sandbox-required": "node tests/sandbox-required.test.js",
    "test:update": "node tests/update.test.js",
    "test:contrast": "node tests/contrast.test.js",
    "test:placeholders": "node tests/placeholders.test.js",
    "test:frontmatter": "node tests/frontmatter.test.js",
    "test:project-types": "node tests/project-types.test.js",
    "test:rule-export": "node tests/rule-export.test.js",
    "test:composer-meta": "node tests/composer-meta.test.js",
    "test:version-store": "node tests/version-store.test.js",
    "test:trash-store": "node tests/trash-store.test.js",
    "test:includes": "node tests/includes.test.js",
    "test:reverse": "node tests/reverse-control-update.js",
    "test:reverse-split": "node tests/reverse-control-split.js",
    "test:packaged": "node tests/packaged-smoke.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:quick": "npm run lint && npm test && npm run test:debounce && npm run test:logger && npm run test:sandbox && npm run test:update && npm run test:contrast && npm run test:placeholders && npm run test:frontmatter && npm run test:project-types && npm run test:rule-export && npm run test:composer-meta && npm run test:version-store && npm run test:trash-store && npm run test:includes",
    "test:all": "npm run test:quick && npm run test:ui && npm run test:fn && npm run test:tabs && npm run test:close && npm run test:render && npm run test:heal && npm run test:reverse && npm run test:reverse-split",
    "bench": "node tests/search-bench.js",
    "sync-vendor": "node scripts/sync-vendor.js",
    "prebuild": "node scripts/sync-vendor.js",
    "build": "electron-builder --win",
    "predist": "node scripts/sync-vendor.js",
    "dist": "electron-builder --win portable"
  },
  "keywords": [
    "prompt",
    "workflow",
    "prompt-manager",
    "prompt-engineering",
    "electron",
    "markdown"
  ],
  "author": "qiqiqi-max",
  "license": "MIT",
  "homepage": "https://github.com/qiqiqi-max/Prompt-Flow-Manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiqiqi-max/Prompt-Flow-Manager.git"
  },
  "bugs": {
    "url": "https://github.com/qiqiqi-max/Prompt-Flow-Manager/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "diff-match-patch": "1.0.5",
    "dompurify": "3.4.16",
    "electron": "43.7.2",
    "electron-builder": "26.17.0",
    "eslint": "9.39.1",
    "marked": "11.2.0"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "yauzl": "2.10.0"
  },
  "build": {
    "appId": "com.promptflow.manager",
    "productName": "Prompt Flow Manager",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron-main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "prompts/**/*",
      "workflows/**/*",
      "templates/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "icon": "prompt-flow-manager.ico"
    }
  }
}
